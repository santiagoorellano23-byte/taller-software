  "components": [
    {
      "name": "Acción principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Confirmación explícita; tamaño compartido, ampliado a 52px en recepción.",
      "html": "<button class=\"ds-primary\">Confirmar ingreso</button>",
      "css": ".ds-primary{font-family:var(--f,'Barlow',system-ui,sans-serif);font-size:15px;font-weight:600;cursor:pointer;min-height:44px;padding:9px 14px;border:1px solid var(--accion,#af1927);border-radius:6px;background:var(--accion,#af1927);color:var(--sobre-accion,#fff);transition:background-color 120ms}.ds-primary:hover{background:var(--accion-hover,#8d1320);border-color:var(--accion-hover,#8d1320)}.ds-primary:focus-visible{outline:3px solid var(--red,#af1927);outline-offset:2px}.ds-primary:active{filter:brightness(.94)}.ds-primary:disabled{cursor:not-allowed;background:var(--surface-3,#eceef0);border-color:var(--line,#e3e6e9);color:var(--muted,#5d6871)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Acción secundaria",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Volver o editar con superficie y borde, sin competir con la confirmación.",
      "html": "<button class=\"ds-secondary\">Volver</button>",
      "css": ".ds-secondary{font-family:var(--f,'Barlow',system-ui,sans-serif);font-size:15px;font-weight:600;cursor:pointer;min-height:44px;padding:9px 14px;border:1px solid var(--line-strong,#c5cbd0);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#22282e)}.ds-secondary:hover{background:var(--surface-2,#f8f9fa)}.ds-secondary:focus-visible{outline:3px solid var(--red,#af1927);outline-offset:2px}.ds-secondary:active{background:var(--surface-3,#eceef0)}"
    },
    {
      "name": "Campo de recepción",
      "kind": "input",
      "refersTo": "receiving-input",
      "description": "Etiqueta permanente, ayuda vinculada y tamaño efectivo de 16px.",
      "html": "<label class=\"ds-field\">Modelo<input aria-describedby=\"ds-model-help\" placeholder=\"Modelo del vehículo\"><small id=\"ds-model-help\">Usá el nombre que figura en el vehículo.</small></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:var(--f,'Barlow',system-ui,sans-serif);font-size:14px;color:var(--ink,#22282e)}.ds-field input{font-family:var(--f,'Barlow',system-ui,sans-serif);font-size:16px;min-height:52px;padding:10px 12px;border:1px solid var(--line-strong,#c5cbd0);border-radius:12px;background:var(--surface,#fff);color:var(--ink,#22282e);caret-color:var(--red,#af1927)}.ds-field input:hover{border-color:var(--ink-2,#404a53)}.ds-field input:focus-visible{outline:3px solid var(--red,#af1927);outline-offset:2px}.ds-field small{font-size:13px;color:var(--muted,#5d6871)}"
    },
    {
      "name": "Navegación Más",
      "kind": "nav",
      "refersTo": "more-navigation",
      "description": "Grupo de B: filas legibles con iconos locales. La muestra no ejecuta navegación del producto.",
      "html": "<nav class=\"ds-more\" aria-label=\"Consulta\"><a href=\"#documentos\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6\"/></svg><span>Documentos</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></a><a href=\"#biblioteca\"><span>Biblioteca técnica</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></a></nav>",
      "css": ".ds-more{border:1px solid var(--line,#e3e6e9);border-radius:16px;background:var(--surface,#fff);overflow:hidden}.ds-more a{display:flex;align-items:center;gap:12px;min-height:56px;padding:14px 16px;color:var(--ink,#22282e);font:16px var(--f,'Barlow',system-ui,sans-serif);text-decoration:none}.ds-more a+a{border-top:1px solid var(--line-2,#eef0f2)}.ds-more span{flex:1;overflow-wrap:anywhere}.ds-more svg{width:22px;height:22px;flex:none}.ds-more a:hover{background:var(--surface-2,#f8f9fa)}.ds-more a:focus-visible{outline:3px solid var(--red,#af1927);outline-offset:2px;outline-offset:-3px}.ds-more a:active{transform:scale(.985)}@media(prefers-reduced-motion:reduce){.ds-more a:active{transform:none}}"
    },
    {
      "name": "Estado con palabras",
      "kind": "chip",
      "refersTo": "status-warning",
      "description": "Estado textual con icono; el color refuerza la explicación.",
      "html": "<span class=\"ds-status\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"m12 3 10 18H2L12 3zM12 9v5M12 17v1\"/></svg>Bloqueado · falta autorización</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:3px 9px;border:1px solid var(--amber-line,#EFD2A6);border-radius:4px;background:var(--amber-bg,#FCEFDD);color:var(--amber,#8A4B00);font-family:var(--f,'Barlow',system-ui,sans-serif);font-weight:600;font-size:13px;line-height:1.25}.ds-status svg{width:16px;height:16px;flex:none}"
    },
