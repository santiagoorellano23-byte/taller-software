      "css": ".ds-motive{position:relative;display:flex;flex-direction:column;justify-content:space-between;align-items:start;text-align:left;gap:12px;min-height:90px;padding:14px;border:1px solid var(--line-strong,#c5cbd0);border-radius:16px;background:var(--surface,#fff);color:var(--ink,#22282e);font:16px var(--f,'Barlow',system-ui,sans-serif);cursor:pointer}.ds-motive strong{font-size:16px;font-weight:600}.ds-motive[aria-pressed=true]{background:var(--red-tint,#fff0f1);border-color:var(--red,#af1927);box-shadow:inset 0 0 0 1px var(--red,#af1927)}.ds-check{align-self:end;color:var(--red,#af1927)}.ds-motive:hover{border-color:var(--ink,#22282e)}.ds-motive:focus-visible{outline:3px solid var(--red,#af1927);outline-offset:2px}.ds-motive:active{transform:scale(.985)}@media(prefers-reduced-motion:reduce){.ds-motive:active{transform:none}}"
